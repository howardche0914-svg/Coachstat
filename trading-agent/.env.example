# --- Required keys ---
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Free paper-trading keys at https://app.alpaca.markets/ (Paper account)
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...

# --- Trading mode ---
# Keep this true. Setting it to false enables REAL-MONEY trading and also
# requires CONFIRM_LIVE_TRADING to be set to the exact confirmation phrase.
ALPACA_PAPER=true
# CONFIRM_LIVE_TRADING=

# --- Universe ---
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,SPY,QQQ,JPM

# --- Risk limits (enforced in code; the AI cannot override them) ---
MAX_ORDER_USD=2000          # largest single order, in dollars
MAX_POSITION_PCT=10         # max % of equity in any one stock
CASH_RESERVE_PCT=10         # % of equity always kept in cash
MIN_CONFIDENCE=0.6          # trades below this AI confidence are skipped
MAX_TRADES_PER_RUN=4        # max orders per cycle
MAX_DAILY_LOSS_PCT=3        # halt all trading if the account is down this much today

# --- Research / loop ---
MAX_WEB_SEARCHES=12         # web searches the AI may run per cycle
LOOP_INTERVAL_MINUTES=60    # cycle interval when running with --loop
